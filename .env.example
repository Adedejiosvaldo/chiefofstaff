# LLM Providers & Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
GROQ_API_KEY=your_groq_api_key

# OpenRouter (Highly Recommended for Hybrid Routing)
OPENROUTER_API_KEY=your_openrouter_api_key

# Model Routing (Hybrid Model Setup)
# 1. Claude 3.5 Sonnet for active WhatsApp chatting & ghostwriting (Premium quality)
LLM_MODEL_WHATSAPP=anthropic/claude-3.5-sonnet

# 2. Gemini 2.0 Flash for background crons, logs auditing & reflections (Ultra-cheap)
LLM_MODEL_CRONS=google/gemini-2.0-flash

# Buffer API (For LinkedIn scheduling)
BUFFER_ACCESS_TOKEN=your_buffer_access_token

# WhatsApp Configuration
WHATSAPP_MODE=self-chat
WHATSAPP_ALLOWED_USERS=your_phone_number_with_country_code # e.g., 2348000000000
unauthorized_dm_behavior=ignore
reply_prefix=""
