# ==============================================================================
# PERSONAL CHIEF OF STAFF - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- 1. LLM Providers & API Keys ---
# Primary recommended provider (powers both DeepSeek-V3 and Gemini Flash):
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional direct provider keys (if not using OpenRouter):
DEEPSEEK_API_KEY=your_deepseek_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GROQ_API_KEY=your_groq_api_key

# --- 2. Model Routing (Under $1.00/Month Setup) ---
# Active WhatsApp conversation, brain dumps & LinkedIn ghostwriting:
LLM_MODEL_WHATSAPP=deepseek/deepseek-chat

# Background scheduled crons & routine audits (Gemini Flash or DeepSeek-V3):
LLM_MODEL_CRONS=google/gemini-2.0-flash

# --- 3. Developer & Activity Tracking ---
# Your GitHub username for global commit aggregation across all public repos:
GITHUB_USERNAME=Adedejiosvaldo

# Optional GitHub token (increases rate limits for commit fetching):
GITHUB_TOKEN=your_optional_github_personal_access_token

# Local repository paths to scan (comma-separated):
GIT_REPO_PATHS=/opt/repos/chiefofstaff,/opt/repos/zgic-staffclockin

# --- 4. Productivity Integrations ---
# Todoist API token (Settings > Integrations > Developer):
TODOIST_API_TOKEN=your_todoist_api_token

# Buffer API Access Token for automated LinkedIn post queueing:
BUFFER_ACCESS_TOKEN=your_buffer_access_token

# --- 5. WhatsApp Gateway Settings ---
WHATSAPP_MODE=self-chat
WHATSAPP_ALLOWED_USERS=your_phone_number_with_country_code # e.g., 2348012345678
unauthorized_dm_behavior=ignore
reply_prefix=""

# --- 6. Localization & Timezone ---
TZ=Africa/Lagos
